+static void ratecontrol_abort_zones( x264_t *h )
+{
+    x264_ratecontrol_t *rc = h->rc;
+    if( rc->zones )
+    {
+        x264_param_t *default_param = rc->zones[0].param;
+        /* Only string parsing created library-owned custom parameter objects.
+         * Caller-supplied callback ownership on failed open is not specified;
+         * leave those external objects and their arenas untouched. */
+        if( rc->zones_from_string )
+            for( int i = 1; i < rc->i_zones; i++ )
+                if( rc->zones[i].param != default_param )
+                {
+                    x264_param_cleanup( rc->zones[i].param );
+                    x264_free( rc->zones[i].param );
+                }
+        x264_param_cleanup( default_param );
+        x264_free( default_param );
+        x264_free( rc->zones );
+    }
+    if( rc->zones_from_string && h->param.rc.zones == rc->zones_from_string )
+    {
+        h->param.rc.zones = NULL;
+        h->param.rc.i_zones = 0;
+    }
+    x264_free( rc->zones_from_string );
